# Chave da API da Anthropic (obrigatória).
# Pegue em https://console.anthropic.com/ e cole aqui.
ANTHROPIC_API_KEY=coloque-sua-chave-aqui

# Modelo:
#   claude-fable-5   → o modelo mais capaz da Anthropic ("o melhor do mundo").
#                      Mais caro; com fallback automático para Opus 4.8.
#   claude-opus-4-8  → padrão recomendado: análise de ponta, ótimo custo.
#   claude-sonnet-5  → mais rápido/barato, qualidade quase-Opus.
MODEL=claude-opus-4-8

# Esforço de raciocínio: low | medium | high | xhigh | max
# high é o equilíbrio recomendado; xhigh para as auditorias mais difíceis.
EFFORT=high

# Porta do servidor local.
PORT=3000

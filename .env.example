# Chave da API da Anthropic (obrigatória).
# Pegue em https://console.anthropic.com/ e cole aqui.
ANTHROPIC_API_KEY=coloque-sua-chave-aqui

# Modelo. Opus 4.8 é o mais capaz (recomendado para o diagnóstico).
# Alternativas por custo/velocidade: claude-sonnet-5
MODEL=claude-opus-4-8

# Esforço de raciocínio: low | medium | high | xhigh | max
# high é o equilíbrio recomendado; xhigh para os casos mais difíceis.
EFFORT=high

# Porta do servidor local.
PORT=3000
